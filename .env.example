# Copiar a .env (no versionado) y completar.
# Lo leen docker compose y Spring Boot con el perfil "local" (spring.config.import en application-local.properties).

# Base de datos (docker-compose.yml)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=hospitalbd
DB_USER=hospital
DB_PASSWORD=hospital
DB_ROOT_PASSWORD=change-me

# Secreto JWT en Base64, de al menos 64 bytes. Generarlo con:
#   openssl rand -base64 64 | tr -d '\n'
# Debe ser distinto en cada entorno y nunca subirse al repositorio.
JWT_SECRET=

# Administrador que se crea al arrancar si no existe (contrasena de al menos 12 caracteres)
ADMIN_EMAIL=admin@hospital.local
ADMIN_PASSWORD=
